{
  "name": "maitu-cafe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Maitú Café — Del origen a tu taza. Experiencia web cinematográfica y tienda.",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "preview": "vite preview",
    "video:placeholder": "python3 scripts/generate-placeholder-video.py",
    "video:optimize": "bash scripts/optimize-video.sh",
    "dev:web": "vite",
    "dev:api": "node --watch --no-warnings server/index.js",
    "start": "node --no-warnings server/index.js",
    "seed:demo": "node --no-warnings server/seed-demo.js",
    "demo": "DB_PATH=data/demo.db DEMO_MODE=1 node --no-warnings server/index.js"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/open-sans": "^5.2.5",
    "@gsap/react": "^2.1.2",
    "express": "^5.3.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^8.3.7"
  },
  "engines": {
    "node": ">=22.13"
  }
}
