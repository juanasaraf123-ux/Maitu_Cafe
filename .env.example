# Copiar como .env y completar. NO subir .env al repositorio.

PORT=8787
# URL pública del sitio (para la redirección después de pagar)
PUBLIC_URL=http://localhost:5173

# Panel de administración (/admin)
ADMIN_PASSWORD=cambia-esta-clave
# Cadena larga y aleatoria para firmar las sesiones del panel
ADMIN_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Wompi (panel de comercio → Desarrolladores). Empezar con llaves de pruebas.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Horas antes de cancelar pedidos sin pagar (libera el stock reservado)
ORDER_EXPIRY_HOURS=24
